# Copy this file to .env and fill in values for local development.
# On Railway, set these in the project's Variables tab — never commit .env.

# Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-secret-key-here

# Set to False in production
DEBUG=False

# Comma-separated. Include your Railway domain e.g. myapp.railway.app
ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated. Required for Railway HTTPS to pass CSRF checks.
CSRF_TRUSTED_ORIGINS=https://myapp.railway.app

# Provided automatically by Railway when you add a Postgres plugin.
# For local dev with SQLite, leave this unset.
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Resend email — production only, not needed locally (DEBUG=True uses console backend).
# Get your API key at: resend.com → API Keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
# Must be a verified domain in Resend. Use onboarding@resend.dev for testing.
DEFAULT_FROM_EMAIL=onboarding@resend.dev
